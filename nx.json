{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/packages/vite-config/**/*",
      "{workspaceRoot}/tools/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/lib"
      ]
    },
    "dev": {
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}

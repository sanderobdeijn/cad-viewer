{
  "name": "@mlightcad/cad-simple-viewer",
  "version": "1.7.6",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "keywords": [
    "autocad",
    "cad",
    "cad-viewer",
    "dwg",
    "dwg-viewer",
    "dxf",
    "dxf-viewer",
    "mlight",
    "mlightcad"
  ],
  "files": [
    "dist",
    "lib",
    "icons.ts",
    "src/ui/icons.ts",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-simple-viewer.umd.cjs",
  "module": "./dist/cad-simple-viewer.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-simple-viewer.js",
      "require": "./dist/cad-simple-viewer.umd.cjs"
    },
    "./icons": {
      "types": "./src/ui/icons.ts",
      "import": "./src/ui/icons.ts",
      "default": "./lib/ui/icons.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "copy:workers": "node ../../tools/copy-workers.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/common": "workspace:*",
    "@mlightcad/data-model": "workspace:*",
    "@mlightcad/geometry-engine": "workspace:*",
    "@mlightcad/graphic-interface": "workspace:*",
    "@mlightcad/mtext-parser": "workspace:*",
    "@mlightcad/mtext-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*",
    "@mlightcad/three-viewcube": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/rbush": "^3.0.4",
    "@types/three": "^0.186.0",
    "lodash-es": "4.17.21",
    "mitt": "^3.0.1",
    "rbush": "^4.0.1",
    "three": "^0.186.1"
  },
  "peerDependencies": {
    "@mlightcad/common": "workspace:*",
    "@mlightcad/data-model": "workspace:*",
    "@mlightcad/geometry-engine": "workspace:*",
    "@mlightcad/graphic-interface": "workspace:*",
    "@mlightcad/mtext-parser": "workspace:*",
    "@mlightcad/mtext-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*",
    "lodash-es": "4.17.21",
    "three": "^0.186.1"
  }
}

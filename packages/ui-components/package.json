{
  "name": "@mlightcad/ui-components",
  "version": "0.1.11",
  "description": "One common UI component library based on Element Plus for web-based CAD",
  "license": "MIT",
  "author": "MLight Lee <mlight.lee@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/ui-components"
  },
  "keywords": [
    "ui",
    "component",
    "vue",
    "element plus",
    "cad",
    "AutoCAD",
    "tool palette",
    "mlight"
  ],
  "main": "dist/ui-components.umd.js",
  "module": "dist/ui-components.es.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "files": [
    "dist",
    "lib/*.js",
    "lib/*.ts",
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "vue-tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "element-plus": "^2.12.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "sass": "^1.95.1",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.3",
    "vite-plugin-css-injected-by-js": "^3.5.1",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.4.21",
    "vue-tsc": "^2.1.6"
  },
  "peerDependencies": {
    "element-plus": "^2.12.0",
    "vue": "^3.4.21"
  }
}
